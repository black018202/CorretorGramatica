-- Função para remover acentos e o ç na hora de comparar
local function normalizar(texto)
    local subs = {
        ["á"]="a", ["à"]="a", ["ã"]="a", ["â"]="a", ["ä"]="a",
        ["é"]="e", ["è"]="e", ["ê"]="e", ["ë"]="e",
        ["í"]="i", ["ì"]="i", ["î"]="i", ["ï"]="i",
        ["ó"]="o", ["ò"]="o", ["õ"]="o", ["ô"]="o", ["ö"]="o",
        ["ú"]="u", ["ù"]="u", ["û"]="u", ["ü"]="u",
        ["ç"]="c"
    }
    return string.lower(texto):gsub("[%z\1-\127\194-\244][\128-\191]*", function(c)
        return subs[c] or c
    end)
end

