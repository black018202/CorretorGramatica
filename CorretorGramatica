-- Criando mapa comparativo normalizado
local mapaNormalizado = {}
for chave, valor in pairs(dicionarioCorrecao) do
    mapaNormalizado[normalizar(chave)] = valor
end

-- Função Principal de Correção Gramatical
local function corrigirTexto(textoOriginal)
    if not textoOriginal or textoOriginal == "" then return "" end
    
    local palavras = string.split(textoOriginal, " ")
    for i, palavra in ipairs(palavras) do
        local prefixo, palavraLimpa, sufixo = string.match(palavra, "^(%p*)(.-)(%p*)$")
        if palavraLimpa and palavraLimpa ~= "" then
            local busca = normalizar(palavraLimpa)
            if mapaNormalizado[busca] then
                palavras[i] = prefixo .. mapaNormalizado[busca] .. sufixo
            end
        end
    end
    
    local textoCorrigido = table.concat(palavras, " ")
    
    local primeiraLetra = string.sub(textoCorrigido, 1, 1)
    textoCorrigido = string.upper(primeiraLetra) .. string.sub(textoCorrigido, 2)
    
    local ultimoCaractere = string.sub(textoCorrigido, -1)
    if not string.find(ultimoCaractere, "[%.%!%?]") then
        textoCorrigido = textoCorrigido .. "."
    end
    
    return textoCorrigido
end

-- Função para enviar no Chat do Jogo
local function enviarParaOChat(mensagem)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if generalChannel then
            generalChannel:SendAsync(mensagem)
        end
    else
        local defaultChatSystemChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if defaultChatSystemChatEvents then
            local sayMessageRequest = defaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if sayMessageRequest then
                sayMessageRequest:FireServer(mensagem, "All")
            end
        end
    end
end

